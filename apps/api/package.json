{
  "name": "@d21/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "admin:set-password": "node --import tsx src/modules/auth/operator.ts set-password",
    "admin:revoke-sessions": "node --import tsx src/modules/auth/operator.ts revoke-sessions"
  },
  "dependencies": {
    "@d21/contracts": "*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "tsup": "^8.5.0"
  }
}
