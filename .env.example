# Local development only. Replace these values for any shared environment.
POSTGRES_DB=d21
POSTGRES_USER=d21
POSTGRES_PASSWORD=d21_local_only
POSTGRES_PORT=54329
DATABASE_URL=postgresql://d21:d21_local_only@127.0.0.1:54329/d21
API_HOST=127.0.0.1
API_PORT=3001

# Browser origin for cookie security and request-origin checks (no trailing slash).
APP_ORIGIN=http://127.0.0.1:5173

# Combined built hosting; leave false for the Vite development setup.
SERVE_WEB=false
# Comma-separated verified inbound proxy IPs/CIDRs. Empty means no proxy trust.
TRUSTED_PROXY_CIDRS=

# Personal-link copying needs a private key ring in process environment or an
# external env file OUTSIDE this checkout. Never commit or regenerate keys on startup.
# See docs/wiki/simplification-stage-1.md. Without keys, existing access/revocation
# work, but new-link generation and encrypted-link copying return a safe 503.
# JUROR_LINK_KEYS={"key-id":"64 hex characters for a random 256-bit key"}
# JUROR_LINK_ACTIVE_KEY_ID=key-id
